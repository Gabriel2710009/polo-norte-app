DISCORD_TOKEN=tu_token_aqui
DATABASE_URL=postgresql://usuario:password@host:5432/polo_norte

# Canal donde llegan los logs de stash (guardar/sacar items)
LOGS_CHANNEL_ID=1358026298907168778

# Canal donde se envian las alertas de items ilegales
ALERT_CHANNEL_ID=1447055354339786762

# Rol al que se pingea en las alertas
ALERT_ROLE_ID=978342236771217480

# Canal donde llegan los logs de fichaje (inicio/cierre de turno)
FICHAJE_CHANNEL_ID=1439412878569504820

# Canal para logs internos del bot (errores, cambios, validaciones)
LOG_CHANNEL_ID=1482930516393984142

# Blacklist de postulaciones
BLACKLIST_POSTULACIONES_ROLE_ID=id_del_rol_blacklist
BLACKLIST_LOG_CHANNEL_ID=id_del_canal_de_blacklist
POSTULACIONES_CATEGORY_ID=id_de_la_categoria_de_postulaciones

# Roles que evitan el bloqueo (separados por coma, ej: "111,222,333")
BLACKLIST_BYPASS_ROLE_IDS=

# true  → si alguien tiene el rol pero no está en DB, igual se bloquea
# false → solo bloquea si el registro existe en PostgreSQL
BLACKLIST_ALLOW_ROLE_FALLBACK=true

# Canal donde se envía alerta cuando un blacklistado abre ticket (0 para desactivar)
BLACKLIST_STAFF_ALERT_CHANNEL_ID=0
# Rol al que se pinge en el canal de alerta (0 para solo embed, sin ping)
BLACKLIST_STAFF_ALERT_ROLE_ID=0

# Las tablas de blacklist se crean automáticamente en la misma base de datos PostgreSQL (DATABASE_URL).

# ------------------------------------------------------------------
# Sistema de monitoreo interno (StatusReporter / BotMonitor)
# ------------------------------------------------------------------

# ID del administrador que recibe los reportes de estado por DM privado
STATUS_REPORT_USER_ID=691475896019714139

# Cada cuántos minutos se envía el reporte periódico de estado (default: 30)
STATUS_REPORT_INTERVAL_MINUTES=30
